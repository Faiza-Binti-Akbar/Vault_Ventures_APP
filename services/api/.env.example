PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=vault_mobile_app
DB_PASSWORD=your_password_here
DB_NAME=vault_ventures_mobile

# Development-only registration persistence. Keep disabled until the reviewed
# M01/M02 migrations and owner-supplied legal document versions are installed.
REGISTRATION_PERSISTENCE_ENABLED=false
REGISTRATION_REQUIRED_CONSENTS=DEMO_TERMS:0.1-demo,DEMO_SIMULATION:0.1-demo

# Non-production participant access-JWT signing secret. Use at least 32 random
# bytes and never commit the actual value. Session persistence also requires M03.
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes
SESSION_PERSISTENCE_ENABLED=false

# One-command, process-local write authorization for the reviewed demo legal
# seed only. Do not save ALLOW_DEMO_LEGAL_SEED=true in an environment file.
